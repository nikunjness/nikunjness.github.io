---
// Click-to-load YouTube embed: shows the thumbnail until clicked, so no YouTube scripts or cookies load up front.
interface Props {
  id: string;
  title: string;
  /** Some older videos have no 1280px thumbnail. */
  thumb?: 'maxresdefault' | 'hqdefault';
  /** How wide the player renders, so the browser picks the smallest thumbnail that fits. */
  sizes?: string;
}
const { id, title, thumb = 'maxresdefault', sizes = '(max-width: 640px) 100vw, 400px' } = Astro.props;
const base = `https://i.ytimg.com/vi_webp/${id}`;
const srcset = [`${base}/mqdefault.webp 320w`, `${base}/sddefault.webp 640w`]
  .concat(thumb === 'maxresdefault' ? [`${base}/maxresdefault.webp 1280w`] : [])
  .join(', ');
---

<div class="yt" data-id={id}>
  <button type="button" aria-label={`Play: ${title}`}>
    <img src={`${base}/sddefault.webp`} srcset={srcset} sizes={sizes} alt="" loading="lazy" decoding="async" width="640" height="360" />
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const id = el.dataset.id!;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = el.querySelector('button')!.getAttribute('aria-label') ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }
  .yt button {
    all: unset;
    cursor: pointer;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .yt img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.3s;
  }
  .yt button:hover img {
    transform: scale(1.04);
    filter: brightness(0.85);
  }
  .play {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s;
  }
  .yt button:hover .play {
    transform: scale(1.1);
  }
  .yt button:focus-visible .play {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
