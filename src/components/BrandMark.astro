---
import { BRANDS } from '../lib/brands';
interface Props {
  id: string;
  size?: number;
}
const { id, size = 28 } = Astro.props;
const b = BRANDS[id];
---

{
  b.icon ? (
    <img class="bm" src={b.icon} alt="" width={size} height={size} style={`--s:${size}px`} />
  ) : (
    <span class="bm mono" style={`--c:${b.color};--s:${size}px`} aria-hidden="true">
      {b.mono}
    </span>
  )
}

<style>
  .bm {
    width: var(--s);
    height: var(--s);
    border-radius: calc(var(--s) * 0.25);
    flex-shrink: 0;
  }
  .mono {
    display: inline-grid;
    place-items: center;
    background: var(--c);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(var(--s) * 0.36);
    letter-spacing: -0.02em;
  }
</style>
