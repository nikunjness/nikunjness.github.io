---
// Small analytics consent prompt. Google Analytics only loads after "Accept" (see Base.astro).
---

<div class="consent" role="region" aria-label="Cookie consent" hidden>
  <p>
    I use Google Analytics cookies to see what people read here. <span class="nowrap">Is that okay?</span>
  </p>
  <div class="actions">
    <button type="button" class="accept">Accept</button>
    <button type="button" class="decline">No thanks</button>
  </div>
</div>

<script>
  type Consent = {
    enabled: boolean;
    get: () => string | null;
    accept: () => void;
    decline: () => void;
    reset: () => void;
  };
  const consent = (window as unknown as { siteConsent?: Consent }).siteConsent;
  const box = document.querySelector<HTMLElement>('.consent');

  const show = () => {
    if (!box) return;
    box.hidden = false;
    requestAnimationFrame(() => box.classList.add('open'));
  };
  const hide = () => {
    if (!box) return;
    box.classList.remove('open');
    setTimeout(() => (box.hidden = true), 250);
  };

  if (consent?.enabled && box) {
    if (!consent.get()) show();
    box.querySelector('.accept')?.addEventListener('click', () => {
      consent.accept();
      hide();
    });
    box.querySelector('.decline')?.addEventListener('click', () => {
      consent.decline();
      hide();
    });
    // "Cookie settings" link in the footer re-opens the prompt.
    document.querySelectorAll('[data-consent-settings]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        consent.reset();
        show();
        box.querySelector<HTMLButtonElement>('.accept')?.focus();
      }),
    );
  } else {
    document.querySelectorAll<HTMLElement>('[data-consent-settings]').forEach((el) => (el.hidden = true));
  }
</script>

<style>
  .consent {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    max-width: 30rem;
    padding: 0.75rem 0.75rem 0.75rem 1.1rem;
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-soft);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .consent.open {
    opacity: 1;
    transform: none;
  }
  .consent[hidden] {
    display: none;
  }
  p {
    margin: 0;
  }
  .nowrap {
    white-space: nowrap;
  }
  .actions {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  button:hover {
    border-color: var(--ink);
  }
  .accept {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .accept:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  @media (max-width: 560px) {
    .consent {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      max-width: none;
      flex-direction: column;
      align-items: stretch;
    }
    .actions {
      justify-content: flex-end;
    }
  }
</style>
