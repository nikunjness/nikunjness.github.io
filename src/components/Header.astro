---
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || path.startsWith(href) || (href === '/writing/' && path.startsWith('/posts/'));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <span class="mark" aria-hidden="true">N</span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="theme" type="button" aria-label="Switch color theme" title="Switch color theme">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
          d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path></svg
      >
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path
          d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"></path></svg
      >
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header .theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 0.75rem;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.6rem;
    padding-inline: 0.6rem 0.6rem;
    max-width: calc(var(--wrap) - 2 * var(--gutter) + 1.2rem);
    background: color-mix(in srgb, var(--bg-raised) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    border: 1px solid color-mix(in srgb, var(--line-strong) 70%, transparent);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .brand:hover {
    color: var(--ink);
  }
  .mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 0.3s;
  }
  .brand:hover .mark {
    transform: rotate(-12deg) scale(1.05);
  }
  nav {
    margin-left: auto;
    min-width: 0;
  }
  nav ul {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--line) 60%, transparent);
  }
  nav a[aria-current='page'] {
    color: var(--bg);
    background: var(--ink);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--muted);
    cursor: pointer;
  }
  .theme:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }

  /* Small screens: pill holds brand + toggle; nav scrolls on its own row below */
  @media (max-width: 760px) {
    .site-header {
      padding-top: 0.5rem;
    }
    .bar {
      flex-wrap: wrap;
      height: auto;
      border-radius: 24px;
      padding: 0.5rem 0.5rem 0;
      gap: 0.25rem 1rem;
      width: auto;
      margin-inline: 0.5rem;
    }
    .theme {
      margin-left: auto;
    }
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -0.5rem;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav ul {
      padding: 0.3rem 0.5rem 0.5rem;
      min-width: max-content;
      justify-content: space-between;
      gap: 0;
    }
    nav a {
      padding: 0.35rem 0.6rem;
      font-size: 0.9rem;
    }
  }
</style>
