---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
// Preload the two fonts used above the fold so headings don't reflow when they arrive.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description: rawDescription = SITE.description,
  image = SITE.image,
  imageAlt = SITE.imageAlt,
  type = 'website',
  publishedTime,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

// Search engines show roughly 155-160 characters; trim on a word boundary.
const description =
  rawDescription.length > 160 ? rawDescription.slice(0, rawDescription.lastIndexOf(' ', 157)) + '…' : rawDescription;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const isDefaultImage = image === SITE.image;
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={SITE.name} />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.url + '/about/'} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nikunjness" />
    <meta name="twitter:creator" content="@nikunjness" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta name="theme-color" content="#fbfaf7" />

    <script is:inline>
      // Light by default. Apply a saved theme choice before first paint, and flag JS for reveal animations.
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    {ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade sections in as they scroll into view.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    z-index: 100;
    background: var(--ink);
    color: var(--bg);
    padding: 0.5rem 1rem;
    border-radius: 8px;
  }
  .skip:focus {
    left: 0.5rem;
  }
  main {
    min-height: 60vh;
  }
</style>
