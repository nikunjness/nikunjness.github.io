---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';
import { getPosts, postUrl, formatDate, readingTime, excerpt, tagSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, tags, image, linkedin } = post.data;
const yearsOld = new Date().getFullYear() - date.getUTCFullYear();
---

<Base title={title} description={excerpt(post, 160)} image={image?.path} type="article" publishedTime={date}>
  <header class="page-hero post-hero">
    <div class="mesh" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="dots" aria-hidden="true"></div>
    <div class="page-hero-inner wrap-narrow">
      <a class="back" href="/writing/">← All writing</a>
      {post.data.draft && <p class="draft-banner">Draft: only visible in local dev, not published.</p>}
      <h1>{title}</h1>
      <p class="meta">
        <span class="avatar"><img src="/assets/img/portrait.webp" alt="" width="28" height="28" /></span>
        <span>Nikunj Thakkar</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)} min read</span>
      </p>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((t) => (
              <a class="tag" href={`/writing/?tag=${tagSlug(t)}`}>
                #{t}
              </a>
            ))}
          </p>
        )
      }
    </div>
  </header>

  <article class="wrap-narrow">
    {
      image && (
        <div class="cover-wrap">
          <PostCover post={post} size="hero" />
        </div>
      )
    }

    {
      yearsOld >= 6 && (
        <p class="archive-note">
          <span aria-hidden="true">🗂️</span> Written in {date.getUTCFullYear()}. I've left it mostly as it was, so some
          links and details may be out of date.
        </p>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      linkedin && (
        <p class="origin">
          <img src="/assets/img/brand/linkedin.svg" alt="" width="18" height="18" />
          Originally published on <a href={linkedin} rel="noopener">LinkedIn</a>.
        </p>
      )
    }

    <nav class="pager" aria-label="More posts">
      {
        older ? (
          <a href={postUrl(older)}>
            <span class="dir">← Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a class="next" href={postUrl(newer)}>
            <span class="dir">Newer →</span>
            {newer.data.title}
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .post-hero {
    margin-top: -4.4rem;
    padding-top: 4.4rem;
    margin-bottom: 0;
    border-bottom: 0;
  }
  .post-hero .page-hero-inner {
    padding-bottom: 2.5rem;
  }
  .post-hero h1 {
    font-size: clamp(2.3rem, 6vw, 3.8rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: none;
  }
  .back {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }
  .draft-banner {
    margin: 1rem 0 0;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    background: var(--sun);
    color: #0f0e0c;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1.4rem 0 0;
    font-size: 0.93rem;
    color: var(--muted);
  }
  .meta span:nth-child(2) {
    color: var(--ink);
    font-weight: 600;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--grad);
    overflow: hidden;
  }
  .avatar img {
    width: 115%;
    max-width: none;
    height: auto;
    margin-top: 10%;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
  }
  .cover-wrap {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    margin-bottom: 2.5rem;
  }
  .archive-note {
    margin: 0 0 2rem;
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    background: var(--accent-soft);
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .origin {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 3rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--muted);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
  }
  .pager a {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .pager a:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .dir {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.82rem;
    color: var(--muted);
    letter-spacing: 0;
  }
  .pager .next {
    text-align: right;
  }
  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
