---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { SITE, SNEZZI_URL } from '../lib/site';

const recent = (await getPosts()).slice(0, 3);

const logos = [
  { name: 'Snezzi', icon: '/assets/img/brand/snezzi.png' },
  { name: 'Whatfix', icon: '/assets/img/brand/whatfix.png' },
  { name: 'Plivo', icon: '/assets/img/brand/plivo.png' },
  { name: 'Shoppr.ai', icon: '/assets/img/brand/shoppr.png' },
  { name: 'DataOne Innovation Labs', icon: '/assets/img/brand/dataone.png' },
  { name: 'UpSurge Ventures', mono: 'U', color: '#7b61ff' },
  { name: 'Google Summer of Code', icon: '/assets/img/brand/gsoc.png' },
  { name: 'Startup OG', mono: 'OG', color: '#ff4d8d' },
  { name: 'GDG Cloud Ahmedabad', icon: '/assets/img/brand/gdg.png' },
  { name: 'Headstart Gujarat', mono: 'H', color: '#ffb020' },
];

const chapters = [
  { year: '2013', role: 'Engineer', text: 'Google Summer of Code, then Big Data systems for telecom operators at Ishi Systems.' },
  { year: '2016', role: 'Founder', text: 'Co-founded DataOne, built Shoppr.ai, bootstrapped for five years, survived COVID.' },
  { year: '2020', role: 'Product leader', text: 'Acquihired into Whatfix. Led 0→1 product lines there and at Plivo.' },
  { year: '2025', role: 'Founder again', text: 'Started UpSurge Ventures. Now building Snezzi.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  image: new URL('/assets/img/avatar.jpg', SITE.url).href,
  jobTitle: 'Co-founder, Snezzi',
  description: SITE.description,
  sameAs: ['https://www.linkedin.com/in/nikunjness', 'https://x.com/nikunjness', 'https://github.com/nikunjness'],
};
---

<Base jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class="mesh" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="dots" aria-hidden="true"></div>

    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="now-pill" href={SNEZZI_URL}>
          <span class="pulse" aria-hidden="true"></span>
          Now building <strong>Snezzi</strong>
          <span class="sep" aria-hidden="true"></span>
          <span class="pill-extra">AI visibility platform</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <h1>
          I build products, companies <span class="it grad-text nowrap">&amp; communities.</span>
        </h1>

        <p class="lead">
          Engineer turned founder turned product leader, and now founder again. Ten years of taking products
          from zero to one across SaaS, AI, and go-to-market.
        </p>

        <div class="actions">
          <a class="btn btn-primary" href={SNEZZI_URL}>See what I'm building <span class="arrow">→</span></a>
          <a class="btn" href="/about/">Read my story</a>
        </div>
      </div>

      <div class="stage" aria-label="Highlights">
        <div class="halo" aria-hidden="true"></div>
        <picture class="portrait">
          <source srcset="/assets/img/portrait.webp" type="image/webp" />
          <img src="/assets/img/portrait.png" alt="Illustrated portrait of Nikunj Thakkar" width="441" height="515" fetchpriority="high" />
        </picture>
        <span class="chip c1"><img src="/assets/img/brand/snezzi.png" alt="" width="20" height="20" />Co-founder, Snezzi</span>
        <span class="chip c2"><img src="/assets/img/brand/plivo.png" alt="" width="20" height="20" />0→1 products at Whatfix &amp; Plivo</span>
        <span class="chip c3"><img src="/assets/img/brand/whatfix.png" alt="" width="20" height="20" />Acquihired by Whatfix</span>
        <span class="chip c4"><img src="/assets/img/brand/gsoc.png" alt="" width="20" height="20" />GSoC 2013</span>
        <span class="chip c5">🎙️ Host, Startup OG</span>
      </div>
    </div>
  </section>

  <!-- LOGO MARQUEE -->
  <section class="logos" aria-label="Places I've built">
    <p class="logos-label">Where I've built, led, and shown up</p>
    <div class="marquee">
      <ul>
        {
          [...logos, ...logos].map((l, i) => (
            <li aria-hidden={i >= logos.length ? 'true' : undefined}>
              {l.icon ? (
                <img src={l.icon} alt="" width="28" height="28" loading="lazy" />
              ) : (
                <span class="mono" style={`--c:${l.color}`}>
                  {l.mono}
                </span>
              )}
              {l.name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- BENTO -->
  <section class="wrap section">
    <div class="section-head reveal">
      <p class="eyebrow">At a glance</p>
      <h2>Ten years, one habit: <span class="it">building</span>.</h2>
    </div>

    <div class="bento">
      <!-- Snezzi -->
      <a class="tile snezzi reveal" href={SNEZZI_URL}>
        <div class="snezzi-copy">
          <img class="snezzi-logo" src="/assets/img/brand/snezzi-logo.webp" alt="Snezzi" width="160" height="71" />
          <h3>Get your brand into the answers buyers get from AI.</h3>
          <p>
            An AI visibility platform. It tracks how brands show up in ChatGPT, Perplexity, and Google AI,
            then helps fix it with content, CMS-native agents, and a done-for-you option.
          </p>
          <span class="tile-link">snezzi.com <span class="arrow">→</span></span>
        </div>
        <div class="shot">
          <img src="/assets/img/snezzi-dashboard.webp" alt="Snezzi dashboard showing AI visibility, share of voice and visibility by AI platform" width="1439" height="840" loading="lazy" />
        </div>
      </a>

      <!-- Product leader -->
      <div class="tile pm reveal" style="--d:.08s">
        <p class="tile-eyebrow">Product leader · 2020 to 2024</p>
        <h3>New product lines, inside scaled SaaS.</h3>
        <ul class="pm-list">
          <li>
            <img src="/assets/img/brand/whatfix.png" alt="" width="36" height="36" />
            <span><b>Whatfix</b>Led a no-code product analytics line from idea to launch ($250K ARR in two quarters).</span>
          </li>
          <li>
            <img src="/assets/img/brand/plivo.png" alt="" width="36" height="36" />
            <span><b>Plivo</b>Led Contacto, an omnichannel contact center product: agent desktop, knowledge base, conversational AI.</span>
          </li>
        </ul>
      </div>

      <!-- Acquihire -->
      <div class="tile acq reveal" style="--d:.12s">
        <p class="tile-eyebrow">The founder chapter</p>
        <div class="acq-flow" aria-hidden="true">
          <span class="node wordmark"><img src="/assets/img/brand/shoppr-wordmark.png" alt="Shoppr" width="72" height="26" /></span>
          <span class="flow"><i></i></span>
          <span class="node"><img src="/assets/img/brand/whatfix.png" alt="" width="28" height="28" />Whatfix</span>
        </div>
        <p class="mid">Bootstrapped <b>~5 years</b>. COVID turned a growth raise into a survival raise. The team was acquihired.</p>
        <ol class="mini" aria-label="DataOne timeline">
          <li><b>Mar 2016</b>Co-founded DataOne</li>
          <li><b>2020</b>COVID hits the raise</li>
          <li><b>Dec 2020</b>Team joins Whatfix</li>
        </ol>
      </div>

      <!-- Years -->
      <div class="tile years reveal" style="--d:.04s">
        <p class="big">10<span class="plus">+</span></p>
        <p class="muted small">years across engineering, product, and GTM</p>
        <div class="split" aria-hidden="true">
          <span style="--w:24%;--c:#3b82f6"></span>
          <span style="--w:34%;--c:#ff5b1f"></span>
          <span style="--w:28%;--c:#7b61ff"></span>
          <span style="--w:14%;--c:#ff4d8d"></span>
        </div>
        <div class="split-legend">
          <span><i style="--c:#3b82f6"></i>Engineer</span>
          <span><i style="--c:#ff5b1f"></i>Founder</span>
          <span><i style="--c:#7b61ff"></i>Product</span>
          <span><i style="--c:#ff4d8d"></i>Founder again</span>
        </div>
      </div>

      <!-- Startup OG -->
      <a class="tile og reveal" href="/talks/" style="--d:.08s">
        <p class="tile-eyebrow on-dark">Founder &amp; host</p>
        <h3>Startup OG</h3>
        <p class="small">Podcasts, meetups, and events where founders share real stories.</p>
        <div class="wave" aria-hidden="true">
          {Array.from({ length: 28 }, (_, i) => <span style={`--i:${i}`} />)}
        </div>
      </a>

      <!-- GSoC -->
      <a class="tile code reveal" href="/posts/grabbing-the-tag-of-gsocer/" style="--d:.12s">
        <div class="win" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>2013.java</span></div>
          <pre><code><span class="k">// where it started</span>
<span class="p">Summer</span>.of(<span class="s">"Code"</span>)
  .storage(<span class="s">"Cassandra"</span>)
  .at(<span class="s">"TU Wien"</span>);</code></pre>
        </div>
        <p class="small"><img src="/assets/img/brand/gsoc.png" alt="" width="18" height="18" /> First from my Master's stream in Google Summer of Code.</p>
      </a>
    </div>
  </section>

  <!-- JOURNEY -->
  <section class="wrap section">
    <div class="section-head reveal">
      <p class="eyebrow">The path so far</p>
      <h2>Engineer → founder → product leader → <span class="it">founder again.</span></h2>
    </div>
    <ol class="journey">
      {
        chapters.map((c, i) => (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <span class="yr">{c.year}</span>
            <span class="dot" aria-hidden="true" />
            <h3>{c.role}</h3>
            <p>{c.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="center reveal"><a class="btn" href="/work/">See the full timeline <span class="arrow">→</span></a></p>
  </section>

  <!-- WRITING -->
  <section class="wrap section">
    <div class="section-head row reveal">
      <div>
        <p class="eyebrow">Writing</p>
        <h2>Notes from building.</h2>
      </div>
      <a class="more" href="/writing/">All writing →</a>
    </div>
    <div class="posts">
      {
        recent.map((p, i) => (
          <div class="reveal" style={`--d:${i * 0.08}s`}>
            <PostCard post={p} />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: -4.4rem;
    padding-top: 4.4rem;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 7vw, 5.5rem);
  }
  .now-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-raised) 80%, transparent);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-sm);
    font-size: 0.88rem;
    color: var(--ink-soft);
    text-decoration: none;
    backdrop-filter: blur(8px);
  }
  .now-pill strong {
    color: var(--ink);
  }
  .now-pill .sep {
    width: 1px;
    height: 1rem;
    background: var(--line-strong);
  }
  .now-pill .arrow {
    transition: transform 0.2s;
  }
  .now-pill:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .now-pill:hover .arrow {
    transform: translateX(3px);
  }
  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #12b76a;
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #12b76a;
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .hero h1 {
    font-size: clamp(3rem, 6.6vw, 5.8rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin-top: 1.5rem;
    font-weight: 800;
  }
  .nowrap {
    white-space: nowrap;
  }
  .hero h1 .it {
    font-weight: 400;
    letter-spacing: -0.02em;
    padding-right: 0.08em;
  }
  .lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--ink-soft);
    max-width: 34rem;
    margin: 1.75rem 0 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }

  .stage {
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
    aspect-ratio: 1 / 1.05;
    display: grid;
    place-items: center;
  }
  .halo {
    position: absolute;
    width: 82%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(from 200deg, #ff5b1f, #ff4d8d, #7b61ff, #ffc53d, #ff5b1f);
    filter: blur(2px);
    opacity: 0.9;
    animation: spin 24s linear infinite;
  }
  .halo::after {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    background: var(--bg);
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  .portrait {
    position: relative;
    width: 70%;
    margin-top: -6%;
  }
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.25));
  }
  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    animation: float 6s ease-in-out infinite;
  }
  .chip img {
    border-radius: 5px;
  }
  .chip b {
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .c1 { top: 4%; left: -6%; animation-delay: -1s; }
  .c2 { top: 18%; right: -10%; animation-delay: -3s; }
  .c3 { bottom: 26%; left: -14%; animation-delay: -2s; }
  .c4 { bottom: 8%; right: -4%; animation-delay: -4s; }
  .c5 { bottom: -2%; left: 14%; animation-delay: -5s; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* LOGOS */
  .logos {
    border-block: 1px solid var(--line);
    background: var(--bg-sunken);
    padding-block: 1.4rem;
  }
  .logos-label {
    text-align: center;
    margin: 0 0 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee ul {
    display: flex;
    gap: 2.75rem;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: marquee 40s linear infinite;
  }
  .marquee:hover ul {
    animation-play-state: paused;
  }
  .marquee li {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .marquee img {
    border-radius: 7px;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 1.375rem));
    }
  }
  .mono {
    display: inline-grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding-inline: 4px;
    border-radius: 7px;
    background: var(--c);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: -0.02em;
  }

  /* SECTIONS */
  .section {
    margin-top: clamp(4.5rem, 10vw, 7.5rem);
  }
  .section-head {
    margin-bottom: 2rem;
  }
  .section-head h2 {
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    letter-spacing: -0.045em;
    margin-top: 0.75rem;
    max-width: 20ch;
  }
  .section-head .it {
    font-weight: 400;
  }
  .section-head.row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .more {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  /* BENTO */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }
  .tile {
    position: relative;
    overflow: hidden;
    padding: 1.6rem;
    border-radius: var(--radius);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s;
  }
  a.tile:hover {
    color: inherit;
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .tile-eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .big {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 6vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .small {
    font-size: 0.93rem;
    line-height: 1.5;
    margin: 0.6rem 0 0;
  }

  .snezzi {
    grid-column: span 7;
    grid-row: span 2;
    min-height: 34rem;
    display: flex;
    flex-direction: column;
    color: #eafff5;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(45, 212, 191, 0.35), transparent 60%),
      linear-gradient(160deg, #0d4a35 0%, #0a2f23 70%);
    border-color: #0f5a40;
  }
  .snezzi-logo {
    height: 2.4rem;
    width: auto;
    filter: invert(1);
  }
  .snezzi h3 {
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    color: #fff;
    margin-top: 1rem;
    max-width: 18ch;
  }
  .snezzi p {
    color: #b9d9cb;
    font-size: 0.97rem;
    margin: 0.8rem 0 0;
    max-width: 30rem;
  }
  .tile-link {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-weight: 600;
    color: #5eead4;
  }
  .tile-link .arrow {
    transition: transform 0.2s;
  }
  a.tile:hover .tile-link .arrow {
    transform: translateX(4px);
  }
  .shot {
    margin-top: auto;
    padding-top: 1.75rem;
    margin-right: -3.5rem;
    margin-bottom: -2.5rem;
    perspective: 1200px;
  }
  .shot img {
    display: block;
    width: 100%;
    border-radius: 14px 14px 0 0;
    box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.12);
    transform: rotateX(8deg) rotateY(-10deg) rotateZ(1deg);
    transform-origin: left center;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .snezzi:hover .shot img {
    transform: rotateX(3deg) rotateY(-4deg) rotateZ(0deg) translateY(-6px);
  }

  .pm {
    grid-column: span 5;
  }
  .pm h3 {
    font-size: 1.6rem;
    margin-top: 0.6rem;
    max-width: 16ch;
  }
  .pm-list {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .pm-list li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.9rem;
    border-radius: 16px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .pm-list img {
    border-radius: 9px;
    flex-shrink: 0;
  }
  .pm-list b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 0.1rem;
  }

  .acq {
    grid-column: span 5;
  }
  .acq-flow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.2rem 0 1rem;
  }
  .node {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    border-radius: 14px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 700;
    white-space: nowrap;
  }
  .node img {
    border-radius: 7px;
  }
  .node.wordmark {
    padding-block: 0.55rem;
  }
  .node.wordmark img {
    height: 1.55rem;
    width: auto;
    border-radius: 0;
  }
  .flow {
    flex: 1;
    height: 2px;
    position: relative;
    background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 12px);
    overflow: hidden;
  }
  .flow i {
    position: absolute;
    inset: 0;
    width: 40%;
    background: var(--grad);
    animation: flow 2.2s ease-in-out infinite;
  }
