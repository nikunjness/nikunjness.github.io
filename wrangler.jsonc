{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nikunjthakkar-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Keep the *.workers.dev address and per-version preview URLs for testing
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "nikunjthakkar.com", "custom_domain": true },
    // www keeps its existing proxied DNS record; the worker redirects it to the apex
    { "pattern": "www.nikunjthakkar.com/*", "zone_name": "nikunjthakkar.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Run the worker first so www.* requests can be redirected before assets are served.
    "run_worker_first": true
  }
}
